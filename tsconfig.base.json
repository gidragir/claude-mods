{
  // Plugin code runs in a Claude Code hooks worker (no DOM, no Node) and in the agy server, so it
  // is written against neither: es2023 only. JSX compiles to Bifrost's neutral element tree.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "types": [],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@gidragir/bifrost"
  }
}
