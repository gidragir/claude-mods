{
  "name": "claude-mods",
  "private": true,
  "type": "module",
  "description": "Plugins for Claude Code and Google Antigravity (agy), written once with the Bifrost framework",
  "author": "gidragir",
  "license": "MIT",
  "repository": "https://github.com/gidragir/claude-mods",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "new": "node scripts/new-mod.mjs",
    "build": "bun packages/bifrost/src/cli/bin.ts build",
    "dev": "bun packages/bifrost/src/cli/bin.ts dev",
    "check": "node scripts/check.mjs",
    "typecheck": "node scripts/check.mjs --only=tsc && tsc -p packages/bifrost",
    "test": "bun test",
    "test:engine": "node scripts/check.mjs --only=build,test",
    "test:all": "bun test && node scripts/check.mjs",
    "validate": "node scripts/check.mjs --only=build,validate",
    "lint": "biome check .",
    "format": "biome check --write .",
    "types:sync": "node scripts/sync-types.mjs",
    "marketplace": "node scripts/marketplace.mjs",
    "release:check": "node scripts/release-check.mjs",
    "dev:link": "node scripts/dev-link.mjs",
    "dev:link:desktop": "node scripts/dev-link.mjs --desktop",
    "dev:link:agy": "node scripts/dev-link.mjs --agy",
    "dev:unlink": "node scripts/dev-link.mjs --off",
    "dev:unlink:desktop": "node scripts/dev-link.mjs --desktop --off",
    "dev:unlink:agy": "node scripts/dev-link.mjs --agy --off",
    "dev:status": "node scripts/dev-link.mjs --status"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@gidragir/bifrost": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "^26.6.5",
    "typescript": "catalog:"
  },
  "workspaces": {
    "packages": [
      "plugins/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^7.0.2",
      "@biomejs/biome": "2.5.15",
      "@types/bun": "^1.4.3"
    }
  }
}
